# ---- Studio ----
AUTH_MODE=dev                      # dev = trust everyone as DEV_USER; anything else = verify Cloudflare Access JWTs (fails closed)
DEV_USER=you@example.com
STUDIO_PUBLIC_URL=http://localhost:3000
DATABASE_PATH=.data/studio.sqlite  # Node only; Workers use the D1 binding (STUDIO_DB=d1)
CRON_SECRET=                       # shared secret for /api/cron/sweep
MCP_STATIC_TOKEN=                  # optional bearer for clients that cannot do OAuth (Claude Code, curl)

# ---- Cloudflare Access (AUTH_MODE=access) ----
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=

# ---- RunPod ----
RUNPOD_API_KEY=
RUNPOD_WEBHOOK_SECRET=             # HMAC key for the signed webhook URLs
RUNPOD_MODE=pod                    # pod (default) | serverless (TODO)
RUNPOD_API=v2                      # v2 (api.runpod.io/v2: volumes via mounts, pods editable) | v1 (rest.runpod.io/v1)

# Pod mode: the studio creates / starts / stops one Secure Cloud pod
RUNPOD_POD_IMAGE=runpod/comfyui:1.3.3-comfyuiv0.30.0-cuda13.0   # or your build of workers/h3-runpod/Dockerfile.pod
RUNPOD_CUDA_VERSIONS=              # host CUDA versions to allow (RunPod enum values); empty = no constraint
RUNPOD_POD_BODY_OVERRIDES=         # optional JSON merged into the create-pod request (null removes a key), e.g. {"gpuTypePriority":null}
H3_PROMPT_FORMAT=lightx2v-lines    # lightx2v-lines (matches the handoff prompts) | lightx2v-json | blocks
RUNPOD_GPU_TYPES=RTX 5090,RTX PRO 6000,A100 80GB,A100-SXM4-80GB,H100 80GB,H100 PCIe,H200   # substrings of RunPod gpuTypeIds, in priority order
RUNPOD_NETWORK_VOLUMES=            # "DC:volumeId,DC:volumeId" — one model volume per data center; pods are tried per data center in order
RUNPOD_NETWORK_VOLUME_ID=          # empty = local-disk mode: the pod downloads the models at every boot (~68 GB, aria2). Or a network volume id (+ RUNPOD_DATACENTER_IDS)
RUNPOD_POD_BOOTSTRAP=1             # 1 = stock image fetches the job server from /api/pod/bundle at boot; 0 = image already has it
RUNPOD_DATACENTER_IDS=
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_CONTAINER_DISK_GB=120           # local-disk mode needs room for ~68 GB of models
RUNPOD_VOLUME_MOUNT_PATH=/runpod-volume   # models only; ComfyUI + venv live on the container disk (a global volume cannot hold a venv)
RUNPOD_POD_PORT=8000               # the job server inside the pod
RUNPOD_COMFY_PORT=8188
RUNPOD_IDLE_STOP_MINUTES=45        # auto-stop after this long without work (a stop wipes the container disk, so not too eager in local-disk mode)
RUNPOD_POD_USD_PER_HOUR=3          # estimate shown before the first pod exists
RUNPOD_GPU_PRIORITY=availability   # availability | cost (sort the allow-list by measured USD per video second)
STUDIO_WORKER_TOKEN=               # shared secret between the studio and the pod's job server

# Serverless mode (TODO)
RUNPOD_ENDPOINT_ID=
RUNPOD_ASSEMBLER_ENDPOINT_ID=
RUNPOD_GPU_USD_PER_SECOND=0.0012
RUNPOD_SECONDS_PER_OUTPUT_SECOND=32  # handoff: A100 ≈ 35, RTX PRO 6000 ≈ 27 (turbo 8 steps, 1344×768)
RUNPOD_EXECUTION_TIMEOUT_MS=900000

# ---- R2 (all media) ----
R2_ACCOUNT_ID=
R2_BUCKET=studio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://takes.example.com

# ---- Image generation ----
# Disabled for now (TODO): hero frames and element references are uploaded.
# HF_API_BASE_URL is still read by the /playground composer only.
HF_API_BASE_URL=
