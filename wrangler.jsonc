{
  // Cloudflare Workers deployment via OpenNext. Fill in the ids after
  // `wrangler d1 create studio` and `wrangler r2 bucket create studio`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinema-studio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "studio", "database_id": "a665a208-4aad-4b1c-98a6-23c52c9fb737", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "TAKES", "bucket_name": "studio" }],
  // The minute-by-minute sweep lives in workers/cron (Cron Triggers call a
  // `scheduled` handler, not a URL).
  "vars": {
    "STUDIO_DB": "d1",
    "AUTH_MODE": "access",
    "CF_ACCESS_TEAM_DOMAIN": "zyhu.cloudflareaccess.com",
    "CF_ACCESS_AUD": "d1ddd5e5eededf0a270cb63a3099fcdf238f54009d3d13aec0f4a842e5efdce4",
    "STUDIO_PUBLIC_URL": "https://studio.zyhu.dev",
    "R2_PUBLIC_BASE_URL": "https://studio.zyhu.dev/media",
    "R2_BUCKET": "studio",
    "RUNPOD_GPU_USD_PER_SECOND": "0.0012",
    "RUNPOD_SECONDS_PER_OUTPUT_SECOND": "32",
    "RUNPOD_MODE": "pod",
    "RUNPOD_GPU_TYPES": "RTX 5090,RTX PRO 6000,A100 80GB,A100-SXM4-80GB,H100 80GB,H100 PCIe,H200",
    "RUNPOD_CLOUD_TYPE": "SECURE",
    "RUNPOD_CONTAINER_DISK_GB": "50",
    "RUNPOD_VOLUME_MOUNT_PATH": "/workspace",
    "RUNPOD_POD_IMAGE": "runpod/comfyui:1.3.3-comfyuiv0.30.0-cuda13.0",
    "RUNPOD_CUDA_VERSIONS": "13.0,13.1,13.2",
    "H3_PROMPT_FORMAT": "lightx2v-lines",
    "RUNPOD_POD_PORT": "8000",
    "RUNPOD_COMFY_PORT": "8188",
    "RUNPOD_IDLE_STOP_MINUTES": "15"
  }
  // Secrets (dashboard, type Secret — plain vars are overwritten by this file
  // on every deploy): RUNPOD_API_KEY, RUNPOD_NETWORK_VOLUMES ("DC:volumeId,DC:volumeId"),
  // STUDIO_WORKER_TOKEN, RUNPOD_ENDPOINT_ID, RUNPOD_ASSEMBLER_ENDPOINT_ID,
  // RUNPOD_WEBHOOK_SECRET, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
  // HF_API_BASE_URL, HF_API_KEY, CRON_SECRET, MCP_STATIC_TOKEN (optional)
}
