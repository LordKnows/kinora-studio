{
  "name": "@kinora/director",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Director layer for the Kinora Studio MCP: style presets, treatment, rhythm lint, cue maps, J/L-cut assembly, subtitles and batch planning.",
  "bin": {
    "director-mcp": "./dist/mcp.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/styles/build-md.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "mcp": "node dist/mcp.js",
    "styles": "node dist/styles/build-md.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2"
  }
}
