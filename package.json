{
  "name": "openhiggsfield-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/emit-guide.mjs && node scripts/emit-pod-bundle.mjs && next dev --port 3000",
    "build": "node scripts/emit-guide.mjs && node scripts/emit-pod-bundle.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:emit": "node scripts/emit-migrations.mjs",
    "guide:emit": "node scripts/emit-guide.mjs && tsx scripts/emit-catalog-docs.ts",
    "brand": "node scripts/build-brand-assets.mjs",
    "pod:bundle": "node scripts/emit-pod-bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@vercel/blob": "^2.8.0",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.15",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
